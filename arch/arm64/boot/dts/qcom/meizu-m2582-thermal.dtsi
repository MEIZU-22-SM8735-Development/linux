// SPDX-License-Identifier: BSD-3-Clause
#include <dt-bindings/thermal/thermal.h>
/*
 * Meizu 22 (M2582) -- thermal zones.
 *
 * Two independent sensor families.  The TSENS zones are the ones with
 * actuators -- the three cpufreq cooling devices and the GPU's devfreq
 * cooling device:
 *
 *  - SoC TSENS (nodes in tuna.dtsi).  This revision reports deci-Celsius in
 *    the result register and the vendor's tree claims no calibration cells
 *    for it, so the uncalibrated generic v2 path is what the phone itself
 *    runs.  Five of its sensors watch the CPU clusters and one watches the
 *    GPU; the rest monitor blocks with no mainline actuator.
 *
 *  - The PMXR2230, which supplies the CPU rails and protects its own die in
 *    hardware: stage 2 and stage 3 shutdown are armed by default, so it cuts
 *    the rails with Linux out of the loop.  Its zone is a stage indicator
 *    rather than a thermometer, and it cannot drive a cooling device on this
 *    kernel -- see the note in that zone.
 *
 * Everything with an actuator throttles through mainline cooling devices:
 * cpufreq-cpu0 / cpufreq-cpu4 / cpufreq-cpu7 for the clusters and
 * devfreq-3d00000.gpu for the GPU.  Blocks the vendor throttles through
 * cpu-pause / cpu-hotplug / DDR DVFS have no mainline equivalent and stay
 * monitoring only.
 */
&spmi_bus {
	pmxr2230: pmic@1 {
		compatible = "qcom,pmxr2230", "qcom,spmi-pmic";
		reg = <0x1 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmxr2230_temp_alarm: temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x1 0xa 0x0 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0>;
		};
	};
};

/ {
	thermal-zones {
		pmxr2230-thermal {
			polling-delay-passive = <100>;

			thermal-sensors = <&pmxr2230_temp_alarm>;

			trips {
				pmxr2230_trip0: trip0 {
					temperature = <95000>;
					hysteresis = <0>;
					type = "passive";
				};

				pmxr2230_trip1: trip1 {
					temperature = <115000>;
					hysteresis = <0>;
					type = "hot";
				};

				pmxr2230_trip2: trip2 {
					temperature = <145000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			/*
			 * No cooling map here, although stage 1 would be the right
			 * moment to back the SoC off: it cannot bind.
			 *
			 * This sensor is not a thermometer either.  qcom-spmi-temp-alarm
			 * reports DEFAULT_TEMP (37 C) while the PMIC sits in stage 0
			 * and jumps to the stage threshold it tripped on, so a trip
			 * here would mean "the PMIC entered its hardware stage 1".
			 *
			 * A map was tried and never bound.  thermal_of.c matches a
			 * cooling map to a trip through trip->priv, which it sets to
			 * the trip's device node, but qcom-spmi-temp-alarm stores its
			 * own trip index there:
			 *
			 *     qpnp_tm_gen2_rev2_configure_trip_temps_cb():
			 *         trip->priv = THERMAL_INT_TO_TRIP_PRIV(chip->ntrips);
			 *
			 * The driver is allowed to do that (the encoding macros live
			 * in include/linux/thermal.h), so the two uses collide and
			 * pmxr2230-thermal, pm8550ve-d/f all bind no cooling device.
			 * Measured on the board: every lookup logged the map's trip
			 * node against a priv of (efault)/(null) and returned no
			 * match.  Fixing it means changing either the core lookup to
			 * key on the trip id instead of priv, or the driver to keep
			 * its index elsewhere; that is a thermal core change and
			 * belongs in its own round.  Hardware protection is not
			 * affected: stage 2 and stage 3 shutdown run in the PMIC
			 * itself.
			 */
		};

		/*
		 * CPU sensors.
		 *
		 * The whole CPU cluster map was already there in our TSENS nodes
		 * (8 + 11 sensors) but nothing exposed it: only the GPU zone was
		 * modelled, so `thermal_zone*` showed the GPU and the PMIC dies and
		 * no CPU temperature at all.  Names and sensor indices are the
		 * vendor's own, taken from the phone's live tree (its thermal zone
		 * list) and cross-checked against tuna-thermal.dtsi, which uses the
		 * same assignments:
		 *
		 *   cpu-0-0-0  tsens1 s9    cpu-1-0-0  tsens0 s4
		 *   cpu-1-2-0  tsens1 s3    cpu-2-0-0  tsens0 s1
		 *   cpuss-0-0  tsens1 s1
		 *
		 * Trip ladder, and why one trip was not enough.
		 *
		 * With only the vendor's 105 C passive trip the governor never
		 * settled: step_wise compares the temperature against
		 * (trip - hysteresis), so 105 C with 5 s of hysteresis is an
		 * effective 100 C, and it only moves one cooling state per poll.
		 * Measured on the board (6 busy cores, 25 s): the SoC parked at
		 * 104.8 C while the clusters oscillated between one and two OPPs
		 * below maximum -- chatter, with 20 C of headroom left and no
		 * margin at all under the 125 C hot trip.
		 *
		 * So each zone now has two passive trips plus a critical one:
		 *
		 *    85 C  passive, capped to 4 frequency steps per cluster
		 *    95 C  passive, allowed to use the whole OPP table
		 *   115 C  critical: orderly shutdown
		 *
		 * The cap on the low trip is the per-instance upper bound from the
		 * cooling spec (`<&cpu0 0 4>`), so mild heating costs at most four
		 * OPPs and sustained heat escalates to the full table.  Several
		 * instances may share a cooling device: __thermal_cdev_update()
		 * keeps the deepest state requested by any of them
		 * (drivers/thermal/thermal_helpers.c).
		 *
		 * Why the second trip is 95 C and not the vendor's 105 C: measured
		 * on the board with 8 busy cores, the capped first stage saturates
		 * (all three cooling devices at state 4, 1516/2438/2630 MHz) within
		 * two seconds and the SoC still plateaus at 100 C.  Four OPPs are
		 * worth only ~5 C here, so a 105 C trip (effective 103 C) was never
		 * reached and nothing escalated.  At 95 C the full table engages
		 * while the first stage is still saturated, and 20 C are left
		 * before the critical trip.
		 *
		 * The board has no vendor cpu-pause / cpu-hotplug device, so the
		 * actuator is mainline cpufreq cooling -- which is why the maps
		 * point at the first CPU of each policy.  Any one CPU sensor over
		 * its trip throttles all three clusters.
		 *
		 * 115 C critical sits at the PMXR2230's hardware stage 2 threshold
		 * and well under its stage 3 (145 C), so software shuts down in an
		 * orderly way before the PMIC cuts the rails.
		 */

		cpu-0-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 9>;
			trips {
				cpu0_warm: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu0_alert: trip-point1 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu0_crit: trip-point2 {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-warm {
					trip = <&cpu0_warm>;
					cooling-device = <&cpu0 0 4>, <&cpu4 0 4>,
							 <&cpu7 0 4>;
				};
				map-hot {
					trip = <&cpu0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-1-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 4>;
			trips {
				cpu1_warm: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu1_alert: trip-point1 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu1_crit: trip-point2 {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-warm {
					trip = <&cpu1_warm>;
					cooling-device = <&cpu0 0 4>, <&cpu4 0 4>,
							 <&cpu7 0 4>;
				};
				map-hot {
					trip = <&cpu1_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-1-2-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 3>;
			trips {
				cpu12_warm: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu12_alert: trip-point1 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu12_crit: trip-point2 {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-warm {
					trip = <&cpu12_warm>;
					cooling-device = <&cpu0 0 4>, <&cpu4 0 4>,
							 <&cpu7 0 4>;
				};
				map-hot {
					trip = <&cpu12_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-2-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 1>;
			trips {
				cpu2_warm: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu2_alert: trip-point1 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu2_crit: trip-point2 {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-warm {
					trip = <&cpu2_warm>;
					cooling-device = <&cpu0 0 4>, <&cpu4 0 4>,
							 <&cpu7 0 4>;
				};
				map-hot {
					trip = <&cpu2_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpuss-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 1>;
			trips {
				cpuss_warm: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpuss_alert: trip-point1 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpuss_crit: trip-point2 {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-warm {
					trip = <&cpuss_warm>;
					cooling-device = <&cpu0 0 4>, <&cpu4 0 4>,
							 <&cpu7 0 4>;
				};
				map-hot {
					trip = <&cpuss_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		/*
		 * Everything else the four TSENS controllers measure.
		 *
		 * Same source as the CPU zones above: the vendor's own zone names
		 * and sensor indices.  These are the SoC blocks that are not CPU or
		 * GPU -- the always-on island, the camera ISP, Venus video, the DDR
		 * controller, the two Hexagon NSP sensor groups and the modem
		 * subsystem.  Monitoring only, like the CPU ones.
		 */
			/* always-on island */
		aoss-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 0>;
			trips {
				aoss_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 0>;
			trips {
				aoss_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-2-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 0>;
			trips {
				aoss_2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_2_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-3-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 0>;
			trips {
				aoss_3_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_3_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* ISP / camera */
		camera-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 1>;
			trips {
				camera_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				camera_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		camera-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 2>;
			trips {
				camera_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				camera_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Venus video */
		video-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 3>;
			trips {
				video_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				video_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* DDR / memory controller */
		ddr-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 4>;
			trips {
				ddr_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				ddr_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Hexagon NSP (vector) */
		nsphvx-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 11>;
			trips {
				nsphvx_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphvx_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		nsphvx-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 12>;
			trips {
				nsphvx_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphvx_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Hexagon NSP (matrix) */
		nsphmx-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 13>;
			trips {
				nsphmx_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphmx_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		nsphmx-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 14>;
			trips {
				nsphmx_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphmx_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* modem subsystem */
		mdmss-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 1>;
			trips {
				mdmss_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 2>;
			trips {
				mdmss_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-2-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 3>;
			trips {
				mdmss_2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_2_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-3-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 4>;
			trips {
				mdmss_3_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_3_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		/*
		 * The phone's own tree carries six of these, gpu-0..gpu-5, on
		 * tsens2 sensors 5..10, each throttling the GPU from 105 C and
		 * calling it hot at 125 C. Six zones would all drive the same
		 * cooling device and fight over it, so only the first (the one
		 * the factory thermal HAL reports as "gpu") is modelled.
		 *
		 * devfreq cooling numbers its states from the OPP table: 0 is
		 * the 1150 MHz level and 10 is 264 MHz, so the range below lets
		 * throttling use the whole table. 10 ms passive polling keeps
		 * up with the GPU's own 50 ms devfreq cycle.
		 */
		gpu-thermal {
			polling-delay-passive = <10>;

			thermal-sensors = <&tsens2 5>;

			trips {
				gpu_alert0: trip-point0 {
					temperature = <95000>;
					hysteresis = <3000>;
					type = "passive";
				};

				gpu_crit: trip-point1 {
					temperature = <115000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				gpu_cdev {
					trip = <&gpu_alert0>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};
	};
};
