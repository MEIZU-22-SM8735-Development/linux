				};
				map-emerg2 {
					trip = <&cpu_1_1_1_emerg2>;
					cooling-device = <&cpu4_hotplug 0 1>,
							 <&cpu5_hotplug 0 1>;
				};
			};
		};

		cpu-1-2-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 3>;
			trips {
