		cpuss-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 1>;
			trips {
				cpuss_0_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpuss_0_0_crit: trip-point4 {
					temperature = <125000>;
					hysteresis = <1000>;
