		cpu-1-4-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 7>;
			trips {
				cpu_1_4_0_emerg: trip-point2 {
					temperature = <118000>;
					hysteresis = <8000>;
					type = "passive";
