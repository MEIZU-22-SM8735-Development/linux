		};

		cpuss-0-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 2>;
			trips {
				cpuss_0_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpuss_0_1_crit: trip-point4 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};

		/*
		 * GPU: six sensors (tsens2 s5..s10), as the vendor has them.  The
		 * vendor's own die controller runs off gpu-2, so a single zone was
		 * probably not the hot corner.  All six share one cooling device and
		 * __thermal_cdev_update() keeps the deepest request.
		 *
		 * 105 C with the whole OPP table, not the vendor's 0..2: it leaves the
		 * deep cap to its userspace policy at 45.5 C skin, and we have none.
		 */

		gpu-0-thermal {
			polling-delay-passive = <10>;
			thermal-sensors = <&tsens2 5>;
			trips {
				gpu_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				gpu_0_crit: trip-point1 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-gpu {
					trip = <&gpu_0_alert>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};

		gpu-1-thermal {
			polling-delay-passive = <10>;
			thermal-sensors = <&tsens2 6>;
			trips {
				gpu_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				gpu_1_crit: trip-point1 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-gpu {
					trip = <&gpu_1_alert>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};

		gpu-2-thermal {
			polling-delay-passive = <10>;
			thermal-sensors = <&tsens2 7>;
			trips {
				gpu_2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				gpu_2_crit: trip-point1 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-gpu {
					trip = <&gpu_2_alert>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};

		gpu-3-thermal {
			polling-delay-passive = <10>;
			thermal-sensors = <&tsens2 8>;
			trips {
				gpu_3_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				gpu_3_crit: trip-point1 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-gpu {
					trip = <&gpu_3_alert>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};

		gpu-4-thermal {
			polling-delay-passive = <10>;
			thermal-sensors = <&tsens2 9>;
			trips {
				gpu_4_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				gpu_4_crit: trip-point1 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-gpu {
					trip = <&gpu_4_alert>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};

		gpu-5-thermal {
			polling-delay-passive = <10>;
			thermal-sensors = <&tsens2 10>;
			trips {
				gpu_5_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				gpu_5_crit: trip-point1 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-gpu {
					trip = <&gpu_5_alert>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};
		/*
		 * The remaining TSENS sensors: always-on island, camera ISP, Venus
		 * video, DDR controller, the two NSP clusters and the modem
		 * subsystem.
		 *
		 * Monitoring only.  None of these has an actuator in mainline --
		 * the vendor drives DDR DVFS and the NSP clocks from here -- so
		 * they carry no cooling map and the PMIC's stage 2/3 shutdown is
		 * their only backstop.
		 */
			/* always-on island */
		aoss-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 0>;
			trips {
				aoss_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 0>;
			trips {
				aoss_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-2-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 0>;
			trips {
				aoss_2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_2_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-3-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 0>;
			trips {
				aoss_3_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_3_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* ISP / camera */
		camera-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 1>;
			trips {
				camera_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				camera_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		camera-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 2>;
			trips {
				camera_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				camera_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Venus video */
		video-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 3>;
			trips {
				video_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				video_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* DDR / memory controller */
		ddr-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 4>;
			trips {
				ddr_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				ddr_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Hexagon NSP (vector) */
		nsphvx-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 11>;
			trips {
				nsphvx_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphvx_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		nsphvx-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 12>;
			trips {
				nsphvx_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphvx_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Hexagon NSP (matrix) */
		nsphmx-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 13>;
			trips {
				nsphmx_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphmx_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		nsphmx-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 14>;
			trips {
				nsphmx_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphmx_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* modem subsystem */
		mdmss-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 1>;
			trips {
				mdmss_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 2>;
			trips {
				mdmss_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-2-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 3>;
			trips {
				mdmss_2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_2_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-3-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 4>;
			trips {
				mdmss_3_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_3_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

	};
};

/*
 * Hotplug cooling devices for the emergency trips above.
 *
 * One device per CPU, state 1 offlines it.  cpu0 is deliberately absent: the
 * kernel refuses to offline it, so a device for it could only ever fail.
 */
&soc {
	cpu_hotplug: cpu-hotplug {
		compatible = "qcom,cpu-hotplug";

		cpu1_hotplug: cpu1-hotplug {
			qcom,cpu = <&cpu1>;
			qcom,cdev-alias = "cpu1-hotplug";
			#cooling-cells = <2>;
		};

		cpu2_hotplug: cpu2-hotplug {
			qcom,cpu = <&cpu2>;
			qcom,cdev-alias = "cpu2-hotplug";
			#cooling-cells = <2>;
		};

		cpu3_hotplug: cpu3-hotplug {
			qcom,cpu = <&cpu3>;
			qcom,cdev-alias = "cpu3-hotplug";
			#cooling-cells = <2>;
		};

		cpu4_hotplug: cpu4-hotplug {
			qcom,cpu = <&cpu4>;
			qcom,cdev-alias = "cpu4-hotplug";
			#cooling-cells = <2>;
		};

		cpu5_hotplug: cpu5-hotplug {
			qcom,cpu = <&cpu5>;
			qcom,cdev-alias = "cpu5-hotplug";
			#cooling-cells = <2>;
		};

		cpu6_hotplug: cpu6-hotplug {
			qcom,cpu = <&cpu6>;
			qcom,cdev-alias = "cpu6-hotplug";
			#cooling-cells = <2>;
		};

		cpu7_hotplug: cpu7-hotplug {
			qcom,cpu = <&cpu7>;
			qcom,cdev-alias = "cpu7-hotplug";
			#cooling-cells = <2>;
		};
	};
};
