// SPDX-License-Identifier: BSD-3-Clause
/*
 * Meizu 22 (M2582) -- thermal zones.
 *
 * Two independent sources:
 *
 *  - The PMXR2230 supplies the CPU rails and watches its own die temperature
 *    in hardware: stage 2 and stage 3 shutdown are armed by default, so it
 *    shuts the board down on its own with Linux out of the loop. Trip points
 *    are the factory tree's values for this PMIC (95 C passive, 115 C hot,
 *    145 C critical), which match the binding's example for this family.
 *    Software only ever lowers the hardware stage limits.
 *
 *  - SoC TSENS (nodes in tuna.dtsi), which is what the GPU zone below hangs
 *    off. This revision reports deci-Celsius in the result register and the
 *    vendor's tree claims no calibration cells for it, so the uncalibrated
 *    generic v2 path is what the phone itself runs.
 */
&spmi_bus {
	pmxr2230: pmic@1 {
		compatible = "qcom,pmxr2230", "qcom,spmi-pmic";
		reg = <0x1 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmxr2230_temp_alarm: temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x1 0xa 0x0 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0>;
		};
	};
};

/ {
	thermal-zones {
		pmxr2230-thermal {
			polling-delay-passive = <100>;

			thermal-sensors = <&pmxr2230_temp_alarm>;

			trips {
				pmxr2230_trip0: trip0 {
					temperature = <95000>;
					hysteresis = <0>;
					type = "passive";
				};

				pmxr2230_trip1: trip1 {
					temperature = <115000>;
					hysteresis = <0>;
					type = "hot";
				};

				pmxr2230_trip2: trip2 {
					temperature = <145000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		/*
		 * CPU sensors.
		 *
		 * The whole CPU cluster map was already there in our TSENS nodes
		 * (8 + 11 sensors) but nothing exposed it: only the GPU zone was
		 * modelled, so `thermal_zone*` showed the GPU and the PMIC dies and
		 * no CPU temperature at all.  Names and sensor indices are the
		 * vendor's own, taken from the phone's live tree (its thermal zone
		 * list) and cross-checked against tuna-thermal.dtsi, which uses the
		 * same assignments:
		 *
		 *   cpu-0-0-0  tsens1 s9    cpu-1-0-0  tsens0 s4
		 *   cpu-1-2-0  tsens1 s3    cpu-2-0-0  tsens0 s1
		 *   cpuss-0-0  tsens1 s1
		 *
		 * Kept as monitoring only: there are no cooling maps here yet, so
		 * nothing throttles.  The vendor's own CPU zones drive cpu-pause /
		 * cpu-hotplug, which mainline does not have; the equivalent would
		 * be the cpufreq cooling devices that already exist on this board
		 * (cpufreq-cpu0 / -cpu4 / -cpu7), and that is a behaviour change
		 * worth its own boot.
		 *
		 * Trips are the vendor's numbers (105 C passive, 125 C hot) minus
		 * the emergency pair, which only make sense with its own cooling
		 * devices.
		 */
		cpu-0-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 9>;
			trips {
				cpu0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		cpu-1-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 4>;
			trips {
				cpu1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		cpu-1-2-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 3>;
			trips {
				cpu12_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu12_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		cpu-2-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 1>;
			trips {
				cpu2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu2_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		cpuss-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 1>;
			trips {
				cpuss_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpuss_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		/*
		 * Everything else the four TSENS controllers measure.
		 *
		 * Same source as the CPU zones above: the vendor's own zone names
		 * and sensor indices.  These are the SoC blocks that are not CPU or
		 * GPU -- the always-on island, the camera ISP, Venus video, the DDR
		 * controller, the two Hexagon NSP sensor groups and the modem
		 * subsystem.  Monitoring only, like the CPU ones.
		 */
			/* always-on island */
		aoss-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 0>;
			trips {
				aoss_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 0>;
			trips {
				aoss_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-2-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 0>;
			trips {
				aoss_2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_2_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		aoss-3-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 0>;
			trips {
				aoss_3_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				aoss_3_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* ISP / camera */
		camera-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 1>;
			trips {
				camera_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				camera_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		camera-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 2>;
			trips {
				camera_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				camera_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Venus video */
		video-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 3>;
			trips {
				video_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				video_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* DDR / memory controller */
		ddr-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 4>;
			trips {
				ddr_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				ddr_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Hexagon NSP (vector) */
		nsphvx-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 11>;
			trips {
				nsphvx_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphvx_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		nsphvx-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 12>;
			trips {
				nsphvx_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphvx_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* Hexagon NSP (matrix) */
		nsphmx-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 13>;
			trips {
				nsphmx_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphmx_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		nsphmx-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens2 14>;
			trips {
				nsphmx_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				nsphmx_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

			/* modem subsystem */
		mdmss-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 1>;
			trips {
				mdmss_0_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_0_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-1-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 2>;
			trips {
				mdmss_1_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_1_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-2-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 3>;
			trips {
				mdmss_2_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_2_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		mdmss-3-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens3 4>;
			trips {
				mdmss_3_alert: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};
				mdmss_3_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};
		};

		/*
		 * The phone's own tree carries six of these, gpu-0..gpu-5, on
		 * tsens2 sensors 5..10, each throttling the GPU from 105 C and
		 * calling it hot at 125 C. Six zones would all drive the same
		 * cooling device and fight over it, so only the first (the one
		 * the factory thermal HAL reports as "gpu") is modelled.
		 *
		 * devfreq cooling numbers its states from the OPP table: 0 is
		 * the 1150 MHz level and 10 is 264 MHz, so the range below lets
		 * throttling use the whole table. 10 ms passive polling keeps
		 * up with the GPU's own 50 ms devfreq cycle.
		 */
		gpu-thermal {
			polling-delay-passive = <10>;

			thermal-sensors = <&tsens2 5>;

			trips {
				gpu_alert0: trip-point0 {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "passive";
				};

				gpu_hot: trip-point1 {
					temperature = <125000>;
					hysteresis = <0>;
					type = "hot";
				};
			};

			cooling-maps {
				gpu_cdev {
					trip = <&gpu_alert0>;
					cooling-device = <&gpu 0 10>;
				};
			};
		};
	};
};
