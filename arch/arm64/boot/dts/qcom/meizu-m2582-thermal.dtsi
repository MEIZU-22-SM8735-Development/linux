// SPDX-License-Identifier: BSD-3-Clause
#include <dt-bindings/thermal/thermal.h>
/*
 * Meizu 22 (M2582) -- thermal zones.
 *
 * Two independent sensor families.  The TSENS zones are the ones with
 * actuators -- the three cpufreq cooling devices and the GPU's devfreq
 * cooling device:
 *
 *  - SoC TSENS (nodes in tuna.dtsi), which is uncalibrated on this part: the
 *    result register reports deci-Celsius and the vendor's tree claims no
 *    calibration cells, so the generic v2 path is what the phone itself runs.
 *    All 39 sensors are zones, as the vendor has them.
 *
 *  - The PMXR2230, which supplies the CPU rails and protects its own die in
 *    hardware: stage 2 and stage 3 shutdown are armed by default, so it cuts
 *    the rails with Linux out of the loop.  Its zone is a stage indicator
 *    rather than a thermometer, and it cannot drive a cooling device on this
 *    kernel -- see the note in that zone.
 *
 * Actuators: cpufreq-cpu0/-cpu4/-cpu7 for the clusters, devfreq-3d00000.gpu
 * for the GPU, and cpuN-hotplug for the emergency trips.  The board
 * thermistors are not modelled yet, so the vendor's skin-driven ladder has no
 * equivalent here.
 */
&spmi_bus {
	pmxr2230: pmic@1 {
		compatible = "qcom,pmxr2230", "qcom,spmi-pmic";
		reg = <0x1 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmxr2230_temp_alarm: temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x1 0xa 0x0 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0>;
		};
	};
};

/ {
	thermal-zones {
		pmxr2230-thermal {
			polling-delay-passive = <100>;

			thermal-sensors = <&pmxr2230_temp_alarm>;

			trips {
				pmxr2230_trip0: trip0 {
					temperature = <95000>;
					hysteresis = <0>;
					type = "passive";
				};

				pmxr2230_trip1: trip1 {
					temperature = <115000>;
					hysteresis = <0>;
					type = "hot";
				};

				pmxr2230_trip2: trip2 {
					temperature = <145000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			/*
			 * No cooling map: it cannot bind.  thermal_of.c matches a map
			 * to a trip through trip->priv, but qcom-spmi-temp-alarm stores
			 * its own trip index there (THERMAL_INT_TO_TRIP_PRIV, a core
			 * sanctioned encoding), so every lookup compares a trip node
			 * against a small integer.  Fixing that is a thermal core change.
			 * The zone is also not a thermometer: it reports DEFAULT_TEMP
			 * (37 C) until the PMIC enters a hardware stage.  Stage 2/3
			 * shutdown still protects the board on its own.
			 */
		};

		/*
		 * CPU sensors, all 17 of them, as the vendor models them.
		 *
		 *   tsens0  s1..s3 cpu-2-0-{0,1,2}   s4,s5 cpu-1-0-{0,1}
		 *           s6,s7 cpu-1-1-{0,1}      s0    aoss-0
		 *   tsens1  s1,s2 cpuss-0-{0,1}      s3,s4 cpu-1-2-{0,1}
		 *           s5,s6 cpu-1-3-{0,1}      s7,s8 cpu-1-4-{0,1}
		 *           s9    cpu-0-0-0          s10   cpu-0-1-0        s0 aoss-1
		 *
		 * The five cluster hotspots carry the graded ladder (85 C caps the
		 * clusters four OPPs down, 95 C may use the whole table).  The other
		 * twelve only carry the emergency trips: fourteen more copies of the
		 * ladder would give any single sensor the power to throttle the SoC.
		 *
		 * Emergency, per zone, following the vendor's zone-to-CPU mapping:
		 * 118 C offline that CPU, 120 C offline its policy peers, 125 C
		 * critical.  The cooling spec is <&cpuN_hotplug 0 1>, deliberately
		 * not the vendor's 1 1: step_wise releases to an instance's lower
		 * bound, so 1 1 latches the CPU offline for good.  Zones the vendor
		 * points at cpu0 use its policy sibling, which the kernel can
		 * actually offline.
		 */
		cpu-0-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 9>;
			trips {
				cpu_0_0_0_warm: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu_0_0_0_alert: trip-point1 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu_0_0_0_emerg: trip-point2 {
					temperature = <118000>;
					hysteresis = <8000>;
					type = "passive";
				};
				cpu_0_0_0_emerg2: trip-point3 {
					temperature = <120000>;
					hysteresis = <10000>;
					type = "passive";
				};
				cpu_0_0_0_crit: trip-point4 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-warm {
					trip = <&cpu_0_0_0_warm>;
					cooling-device = <&cpu0 0 4>, <&cpu4 0 4>, <&cpu7 0 4>;
				};
				map-hot {
					trip = <&cpu_0_0_0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map-emerg {
					trip = <&cpu_0_0_0_emerg>;
					cooling-device = <&cpu1_hotplug 0 1>;
				};
				map-emerg2 {
					trip = <&cpu_0_0_0_emerg2>;
					cooling-device = <&cpu2_hotplug 0 1>,
							 <&cpu3_hotplug 0 1>;
				};
			};
		};

		cpu-0-1-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens1 10>;
			trips {
				cpu_0_1_0_emerg: trip-point2 {
					temperature = <118000>;
					hysteresis = <8000>;
					type = "passive";
				};
				cpu_0_1_0_emerg2: trip-point3 {
					temperature = <120000>;
					hysteresis = <10000>;
					type = "passive";
				};
				cpu_0_1_0_crit: trip-point4 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				map-emerg {
					trip = <&cpu_0_1_0_emerg>;
					cooling-device = <&cpu1_hotplug 0 1>;
				};
				map-emerg2 {
					trip = <&cpu_0_1_0_emerg2>;
					cooling-device = <&cpu2_hotplug 0 1>,
							 <&cpu3_hotplug 0 1>;
				};
			};
		};

		cpu-1-0-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 4>;
			trips {
				cpu_1_0_0_warm: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				cpu_1_0_0_alert: trip-point1 {
