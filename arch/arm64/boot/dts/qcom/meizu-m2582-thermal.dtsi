		cpu-1-1-0-thermal {
			polling-delay-passive = <100>;
			thermal-sensors = <&tsens0 6>;
			trips {
				cpu_1_1_0_emerg: trip-point2 {
					temperature = <118000>;
					hysteresis = <8000>;
					type = "passive";
				};
				cpu_1_1_0_emerg2: trip-point3 {
					temperature = <120000>;
					hysteresis = <10000>;
					type = "passive";
				};
				cpu_1_1_0_crit: trip-point4 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "critical";
				};
